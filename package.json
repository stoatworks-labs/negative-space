{
  "name": "negative-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Negative-space calculator for LED and projection arrays \u2014 pixel pitch, gap pixels, composite canvas, Resolume advanced output, guide images, PowerPoint geometry and a PDF report.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4322",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:pitch-engine": "node scripts/sync-pitch-engine.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "core-js@3.50.0": true
  }
}
